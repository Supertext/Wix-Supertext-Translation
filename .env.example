# Supertext Translation for Wix: environment variables (Railway variables in production).
# Never commit real values.

# Public HTTPS URL of this app; the dashboard page's iFrame URL in the Wix app dashboard points here.
APP_URL=https://wix-production-xxxx.up.railway.app

# From the app's dashboard on dev.wix.com → your app → OAuth (app ID and app secret).
WIX_APP_ID=
WIX_APP_SECRET=
# Optional: the app's public key (dev.wix.com → your app → Webhooks), to verify the "app removed" webhook.
WIX_PUBLIC_KEY=

# PostgreSQL for site settings and jobs (the shared Railway Postgres; the database is created on first start).
# Without it, settings live in memory only (local development).
DATABASE_URL=postgresql://postgres:password@postgres.railway.internal:5432/wix_supertext

# Optional: encrypts stored Supertext API keys (default: derived from WIX_APP_SECRET).
APP_ENCRYPTION_KEY=

# Optional default Supertext API key for sites that haven't entered their own (the demo site).
# No Supertext account yet? Create one at https://www.supertext.com/person/en/account/signin
# Generate your API key at https://www.supertext.com/en/integrations/api (supertext.com → Integrations → API; requires the Admin role).
SUPERTEXT_API_KEY=

# Optional: a stand-in Supertext API (tests, screenshots) instead of https://api.supertext.com/v1/.
SUPERTEXT_API_ENDPOINT=
# Optional: a stand-in Wix API instead of https://www.wixapis.com.
WIX_API_BASE=
